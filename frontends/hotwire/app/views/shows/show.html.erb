<div class="max-w-2xl">
  <%= link_to "← All shows", shows_path, class: "text-sm text-muted hover:text-paper transition-colors mb-8 inline-block" %>

  <div class="mb-10">
    <p class="font-mono text-accent text-sm mb-2"><%= @show.date_string %></p>
    <h1 class="font-serif text-3xl font-bold text-paper leading-tight"><%= @show.venue %></h1>
    <p class="text-muted mt-2">
      <%= @show.city %><%= @show.state.present? ? ", #{@show.state}" : "" %> · <%= @show.country %>
    </p>
  </div>

  <% @show.show_sets.order(:position).each do |set| %>
    <div class="mb-10">
      <p class="text-xs text-muted tracking-widest mb-4 font-sans">
        <%= set.encore? ? "Encore" : "Set #{set.position + 1}" %>
      </p>
      <ol class="space-y-1.5">
        <% set.songs.order(:position).each_with_index do |song, i| %>
          <li class="flex items-baseline gap-3 group">
            <span class="text-muted text-xs w-5 text-right shrink-0 tabular-nums"><%= i + 1 %></span>
            <span class="flex-1 flex items-baseline gap-1.5 min-w-0">
              <%= link_to song.song_ref.name, song_path(song.song_ref),
                  class: "text-paper hover:text-accent transition-colors" %>
              <% if song.segued? %>
                <span class="text-accent font-semibold text-base leading-none shrink-0">&gt;</span>
              <% end %>
            </span>
            <span class="text-muted text-xs tabular-nums shrink-0"><%= song.song_ref.song_occurences_count %>×</span>
          </li>
        <% end %>
      </ol>
    </div>
  <% end %>
</div>
