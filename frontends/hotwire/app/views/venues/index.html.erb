<div>
  <div class="flex items-baseline justify-between mb-6">
    <h1 class="font-serif text-3xl font-bold text-paper">Venues</h1>
    <span class="text-sm text-muted tabular-nums"><%= number_with_delimiter(@total) %></span>
  </div>

  <%= form_with url: venues_path, method: :get, data: { turbo_frame: "venues_list", controller: "search", action: "input->search#submit" } do |f| %>
    <%= f.search_field :q, value: params[:q],
        placeholder: "Search venues…",
        class: "w-full bg-surface border border-edge rounded px-3 py-2 text-sm text-paper placeholder:text-muted mb-6 focus:outline-none focus:border-accent" %>
  <% end %>

  <%= turbo_frame_tag "venues_list" do %>
    <div class="divide-y divide-edge">
      <% @venues.each do |v| %>
        <%= link_to shows_path(venue: v.venue, city: v.city, state: v.state), class: "flex items-center justify-between py-3 group", data: { turbo_frame: "_top" } do %>
          <div>
            <p class="text-paper group-hover:text-accent transition-colors"><%= v.venue %></p>
            <p class="text-sm text-muted"><%= v.city %><%= v.state.present? ? ", #{v.state}" : "" %> · <%= v.country %></p>
          </div>
          <span class="text-accent text-sm tabular-nums ml-4 shrink-0"><%= v.show_count %> shows</span>
        <% end %>
      <% end %>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>
</div>
